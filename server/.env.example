# ── Server ────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173

# ── Database (MongoDB Atlas) ─────────────────────────────────────────────
# See README.md "MongoDB Atlas Setup" for step-by-step instructions.
MONGODB_URI=your_mongodb_atlas_connection_string

# ── Authentication ────────────────────────────────────────────────────────
# Generate a strong random value, e.g. run: openssl rand -hex 32
JWT_SECRET=your_jwt_secret
JWT_EXPIRES_IN=7d

# ── AI Provider (Google Gemini) ──────────────────────────────────────────
# Optional. The app runs fully without this - matching, ranking, and
# interview generation fall back to deterministic logic. Configure it to
# enable AI-written explanations, comparisons, and the recruiter assistant.
AI_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-2.0-flash

# ── Email (optional - SMTP via Nodemailer) ───────────────────────────────
# Optional. Without these, emails are generated in "preview" mode instead
# of being sent, so the whole recruiting flow still works end-to-end.
EMAIL_HOST=your_smtp_host
EMAIL_PORT=587
EMAIL_USER=your_email
EMAIL_PASSWORD=your_email_password
EMAIL_FROM="Recruitment Team <no-reply@example.com>"

# ── Uploads ───────────────────────────────────────────────────────────────
MAX_UPLOAD_MB=10
